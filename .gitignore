# =============================================================================
# llama-gateway — .gitignore
# =============================================================================

# ── Runtime dependencies ──────────────────────────────────────────────────────
node_modules/
# regenerated by bun install — use bun.lock (text format) instead
bun.lockb

# ── Build output ──────────────────────────────────────────────────────────────
# bun build --compile output
dist/
out/
*.tgz
# compiled binaries — users build these themselves
*.exe

# ── llama-gateway: PERSONAL CONFIG ───────────────────────────────────────────
# gateway.config.yaml contains your local model paths, VRAM settings,
# executable locations, and memory paths. NEVER commit this — it exposes
# your machine layout and breaks other people's setups.
# Commit gateway.config.example.yaml instead (already tracked).
gateway.config.yaml

# ── llama-gateway: AUTO-GENERATED FILES ──────────────────────────────────────
# These are rebuilt from gateway.config.yaml on every startup.
# They contain absolute paths from your local machine — not portable.
generated/

# ── llama-gateway: SCRATCH / DEV ARTIFACTS ───────────────────────────────────
# local dry-run script — not part of the public API
test-gen.ts

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment files ─────────────────────────────────────────────────────────
# .env files may also contain secrets (API keys, paths, etc.)
.env
.env.*
!.env.example          # allow a documented example

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
*.d.ts.map

# ── Test & coverage ───────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Cache files ───────────────────────────────────────────────────────────────
.cache/
.eslintcache
.parcelcache

# ── Editor & IDE ──────────────────────────────────────────────────────────────
# JetBrains
.idea/
# VS Code (add .vscode/extensions.json to allowlist if needed)
.vscode/
*.swp
*.swo
*~
.vscode/settings.json
# ── OS artifacts ─────────────────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ── Personal MDs ─────────────────────────────────────────────────────────────
RELEASES.md